<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Email Verification</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: 'Helvetica', Arial, sans-serif;
    }
    .container {
      max-width: 480px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .header {
      background-color: #004958;
      color: #ffffff;
      text-align: center;
      padding: 30px 20px;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
    }
    .body {
      padding: 30px 20px;
      text-align: center;
      color: #555555;
    }
    .body p {
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 20px;
    }
    .otp-box {
      display: inline-block;
      background: #004958;
      color: #ffffff;
      font-size: 28px;
      letter-spacing: 8px;
      padding: 15px 30px;
      border-radius: 8px;
      font-weight: bold;
      margin: 20px 0;
    }
    .btn {
      display: inline-block;
      background-color: #004958;
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 30px;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 600;
      margin: 20px 0;
    }
    .footer {
      font-size: 12px;
      color: #aaa;
      text-align: center;
      padding: 20px;
      border-top: 1px solid #eee;
    }
    @media screen and (max-width: 500px) {
      .container {
        width: 90%;
      }
      .otp-box {
        font-size: 24px;
        padding: 12px 25px;
      }
      .btn {
        padding: 12px 20px;
        font-size: 14px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Welcome to LYD!</h1>
    </div>
    <div class="body">
      <p>Hello {{name}},</p>
      <p>Thank you for registering with LYD. Please use the OTP below to verify your email address. This OTP is valid for 10 minutes.</p>

      <div class="otp-box">
        {{otp}}
      </div>

      {{#if isRegister}}
      <p>Alternatively, you can verify your email instantly by clicking the button below:</p>
      <a href="{{verification_url}}" class="btn">Verify Email</a>
      {{/if}}

      <p>If you did not register, please ignore this email.</p>
    </div>
    <div class="footer">
      &copy; {{year}} LYD. All rights reserved.
    </div>
  </div>
</body>
</html>