<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Admin Alert - Subscription Expired</title>
</head>

<body style="margin:0;padding:0;background-color:#f3f6f9;font-family:Arial, Helvetica, sans-serif;color:#111827;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f6f9;padding:30px 0;">
  <tr>
    <td align="center">

      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;box-shadow:0 8px 25px rgba(0,0,0,0.08);overflow:hidden;">
        
        <!-- HEADER -->
        <tr>
          <td align="center" style="background:#004958;padding:25px;">
            <!-- Logo -->
            <img src="{{logoUrl}}" alt="Company Logo" width="90" style="display:block;margin:0 auto 15px;border:0;" />
            <h1 style="margin:0;color:#ffffff;font-size:20px;font-weight:600;">🚨 Subscription Expired</h1>
            <p style="margin:6px 0 0;color:#cfe8ed;font-size:14px;">A user's subscription has expired and requires attention</p>
          </td>
        </tr>

        <!-- CONTENT -->
        <tr>
          <td style="padding:30px;">
            <p style="font-size:16px;color:#111827;margin:0 0 15px;">
              Hello Admin,
            </p>
            <p style="font-size:14px;color:#374151;line-height:1.6;margin:0 0 20px;">
              The following user's subscription has expired:
            </p>

            <!-- USER DETAILS CARD -->
            <table width="100%" cellpadding="0" cellspacing="0" style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:20px;">
              <tr>
                <td style="color:#6b7280;padding:6px 0;"><strong>User</strong></td>
                <td align="right" style="padding:6px 0;">{{userName}}</td>
              </tr>
              <tr>
                <td style="color:#6b7280;padding:6px 0;"><strong>Email</strong></td>
                <td align="right" style="padding:6px 0;">{{userEmail}}</td>
              </tr>
              <tr>
                <td style="color:#6b7280;padding:6px 0;"><strong>Plan</strong></td>
                <td align="right" style="padding:6px 0;">{{planName}}</td>
              </tr>
              <tr>
                <td style="color:#6b7280;padding:6px 0;"><strong>Expired</strong></td>
                <td align="right" style="padding:6px 0;">{{expiryDate}}</td>
              </tr>
            </table>

            <!-- CTA BUTTON -->
            <div style="text-align:center;margin-top:25px;">
              <a href="{{adminDashboardUrl}}" 
                 style="background:#004958;
                        color:#ffffff;
                        text-decoration:none;
                        padding:12px 28px;
                        border-radius:8px;
                        font-weight:600;
                        font-size:14px;
                        display:inline-block;">
                View Dashboard
              </a>
            </div>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td style="background:#f9fafb;padding:20px;text-align:center;font-size:12px;color:#9ca3af;">
            © {{year}} {{companyName}}. All rights reserved.
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>