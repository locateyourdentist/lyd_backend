<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Password Reset OTP</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding:40px 0;">
        <table width="420" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.08);">
          <tr>
            <td style="padding:30px;text-align:center;">
              <h2 style="color:#333;margin-bottom:10px;">{{title}}</h2>
              <p style="color:#666;font-size:14px;">
                Hello {{name}},<br><br>
                {{message}}
              </p>

              <div style="margin:30px 0;">
                <span style="
                  display:inline-block;
                  background:#004958;
                  color:#ffffff;
                  font-size:28px;
                  letter-spacing:8px;
                  padding:15px 30px;
                  border-radius:8px;
                  font-weight:bold;
                ">
                  {{otp}}
                </span>
              </div>

            <p style="color:#666;font-size:14px;margin-top:25px;">
                You can also verify your email address by clicking the button below:
              </p>

              {{#if isRegister}}
<div style="margin:20px 0;">
  <a href="{{verification_url}}" 
     style="
       display:inline-block;
       background:#004958;
       color:#ffffff;
       text-decoration:none;
       padding:12px 25px;
       border-radius:6px;
       font-size:14px;
       font-weight:bold;
     ">
    Verify Email
  </a>
</div>
{{/if}}

              <p style="color:#999;font-size:12px;">
                If you didn’t request this, you can safely ignore this email.
              </p>

              <hr style="margin:30px 0;border:none;border-top:1px solid #eee;">

              <p style="color:#aaa;font-size:11px;">
                © {{year}} Your Company. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>