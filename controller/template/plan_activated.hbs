<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<title>Plan Activated</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>

<body style="margin:0;padding:0;background-color:#f3f6f9;font-family:Arial, Helvetica, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f6f9;">
<tr>
<td align="center" style="padding:40px 15px;">

<table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;box-shadow:0 8px 25px rgba(0,0,0,0.08);overflow:hidden;">
  <tr>
    <div align="center" style="background:#004958;padding:35px 25px;">
            <img src="{{logoUrl}}" 
           width="90" 
           alt="Company Logo" 
           style="display:block;margin:0 auto 15px;border:0;" />

      <h1 style="margin:0;color:#ffffff;font-size:22px;font-weight:600;letter-spacing:0.5px;">
        Plan Activated Successfully
      </h1>

      <p style="margin:8px 0 0;color:#cfe8ed;font-size:14px;">
        Your subscription is now active
      </p>

    </td>
  </tr>
  <tr>
    <td style="padding:35px 30px;">
  <p style="margin:0 0 15px;font-size:16px;color:#111827;">
        Hi <strong>{{userName}}</strong>,
      </p>
     <p style="margin:0 0 20px;font-size:15px;color:#4b5563;line-height:1.6;">
        {{activationMessage}}
      </p>
      <table width="100%" cellpadding="0" cellspacing="0" 
             style="background:#f9fbfc;border:1px solid #e5e7eb;border-radius:10px;padding:25px;margin-top:10px;">
        
        <tr>
          <td style="padding:8px 0;font-size:14px;color:#6b7280;">Plan</td>
          <td align="right" style="padding:8px 0;font-size:15px;font-weight:600;color:#111827;">{{planName}}</td>
        </tr>

        <tr>
          <td style="padding:8px 0;font-size:14px;color:#6b7280;">Start Date</td>
          <td align="right" style="padding:8px 0;font-size:14px;color:#111827;">{{startDate}}</td>
        </tr>

        <tr>
          <td style="padding:8px 0;font-size:14px;color:#6b7280;">Expires On</td>
          <td align="right" style="padding:8px 0;font-size:14px;color:#111827;">{{expiryDate}}</td>
        </tr>

        <tr>
          <td style="padding:8px 0;font-size:14px;color:#6b7280;">Amount Paid</td>
          <td align="right" style="padding:8px 0;font-size:16px;font-weight:700;color:#004958;">{{amount}}</td>
        </tr>

      </table>
      <div style="text-align:center;margin-top:30px;">
        <a href="{{dashboardUrl}}" 
           style="background:#004958;
                  color:#ffffff;
                  text-decoration:none;
                  padding:14px 28px;
                  border-radius:8px;
                  font-size:15px;
                  font-weight:600;
                  display:inline-block;">
          Go to Dashboard
        </a>
      </div>

    </td>
  </tr>
  <tr>
    <td style="background:#f9fafb;padding:20px;text-align:center;font-size:12px;color:#9ca3af;">
      © {{year}} {{companyName}}. All rights reserved.
    </td>
  </tr>

</table>

</td>
</tr>
</table>

</body>
</html>